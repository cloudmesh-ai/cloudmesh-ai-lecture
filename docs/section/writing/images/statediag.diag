{
  orientation = landscape;
  Initializing [color = "lightgray"];
  Running [color = "lightgreen"];
  Paused [color = "lightyellow"];
  Terminated [shape = endpoint];

  Initializing -> Running [label = "init"];
  Running -> Paused [label = "pause"];
  Paused -> Running [label = "resume"];
  Running -> Terminated [label = "stop"];
  Paused -> Terminated [label = "stop"];
}
