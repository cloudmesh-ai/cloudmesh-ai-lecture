@startuml
abstract class AIAgent {
    + String name
    + executeTask(task: String)
}

class ResearchAgent {
    + searchWeb(query: String)
    + executeTask(task: String)
}

class CodingAgent {
    + writeCode(lang: String)
    + executeTask(task: String)
}

AIAgent <|-- ResearchAgent
AIAgent <|-- CodingAgent
@enduml
