blockdiag {
    orientation = landscape
    
    User [color=lightyellow];
    API_Gateway [label = "AI Gateway", color=lightblue];
    
    Jobs [label = "Jobs Resource
(Data)", color=lightgreen];
    Models [label = "Models Resource
(KMeans)", color=lightgreen];
    Predictions [label = "Predictions Resource
(Results)", color=lightgreen];
    
    User -> API_Gateway;
    API_Gateway -> Jobs [label = "POST /jobs"];
    API_Gateway -> Models [label = "POST /jobs/{id}/models"];
    API_Gateway -> Predictions [label = "POST /jobs/{id}/models/{m_id}/predictions"];
    
    Jobs -> Models [label = "1 : N"];
    Models -> Predictions [label = "1 : N"];
}
