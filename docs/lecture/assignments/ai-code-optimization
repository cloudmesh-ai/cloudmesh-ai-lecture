## Prototype – Kernel Detection & FLOP Estimate (pure‑Python)

The snippet below:

1. **Parses** a C‑style source string.  
2. **Extracts** each function definition.  
3. **Counts** `for` loops inside the function body.  
4. **Estimates** FLOPs (very rough: 5 ops per iteration, assuming each loop iterates ≈ 1 000 times).  
5. **Ranks** kernels by the estimated FLOP count and saves the ranking to `kernels.json`.


## Appendix Script



```python
import re, json, os, textwrap

# --------------------------------------------------------------
# Example C source – replace with a file read in a real project
# --------------------------------------------------------------
sample_code = """
#include <stdio.h>

void heat_step(double *u, int N) {
    for (int i=1; i<N-1; ++i) {
        for (int j=1; j<N-1; ++j) {
            u[i*N+j] = 0.25*(u[(i-1)*N+j]+u[(i+1)*N+j]+u[i*N+j-1]+u[i*N+j+1]);
        }
    }
}

double dot_product(double *a, double *b, int n) {
    double sum = 0.0;
    for (int i=0; i<n; ++i) {
        sum += a[i]*b[i];
    }
    return sum;
}

/* Helper – not a compute kernel */
static inline double sq(double x) { return x*x; }
"""

# --------------------------------------------------------------
# 1. Extract function signatures and bodies (simple regex)
# This could/should be alternatively done with AI via config file
# --------------------------------------------------------------
func_pat = re.compile(
    r'\b([a-zA-Z_][a-zA-Z0-9_*\s]*?)\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\(([^)]*)\)\s*\{',
    re.MULTILINE)

functions = []
for m in func_pat.finditer(sample_code):
    ret_type, name, args = m.groups()
    start = m.end()
    # naive brace matching to capture the body
    depth = 1
    i = start
    while i < len(sample_code) and depth:
        if sample_code[i] == '{':
            depth += 1
        elif sample_code[i] == '}':
            depth -= 1
        i += 1
    body = sample_code[start:i-1]
    functions.append({
        'name': name.strip(),
        'ret': ret_type.strip(),
        'args': args.strip(),
        'body': body
    })

# --------------------------------------------------------------
# 2. Estimate FLOPs per function (very coarse)
# --------------------------------------------------------------
def estimate_flops(func):
    # count `for` loops
    loop_cnt = len(re.findall(r'\bfor\s*\(', func['body']))
    # try to extract a loop bound variable (e.g., N, n)
    bounds = re.findall(r'for\s*\([^;]*<\s*([a-zA-Z_][a-zA-Z0-9_]*)', func['body'])
    # assume each bound ≈ 1000 iterations if we cannot resolve it
    iter_factor = 1
    for b in bounds:
        iter_factor *= 1000
    # Assume 5 arithmetic ops per iteration (addition, mul, etc.)
    return loop_cnt * iter_factor * 5

for f in functions:
    f['flops'] = estimate_flops(f)

# --------------------------------------------------------------
# 3️⃣ Rank and output
# --------------------------------------------------------------
ranked = sorted(functions, key=lambda x: x['flops'], reverse=True)

print("=== Kernel Ranking (estimated FLOPs) ===")
for idx, f in enumerate(ranked, start=1):
    print(f"{idx}. {f['name']:15} – ≈ {f['flops']:,} FLOPs")

# Save a concise JSON that the later CI steps can read
out_path = "/tmp/kernels.json"
with open(out_path, "w") as fp:
    json.dump([{'name': f['name'], 'flops': f['flops']} for f in ranked], fp, indent=2)

print("\nJSON written to:", out_path)


