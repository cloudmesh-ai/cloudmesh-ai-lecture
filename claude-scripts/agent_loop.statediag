statediag {
    state "Thinking" as think;
    state "Acting" as act;
    state "Observing" as obs;
    state "Final Answer" as done;
    
    [*] -> think;
    think -> act [label = "Decision"];
    act -> obs [label = "Execute Tool"];
    obs -> think [label = "Analyze Result"];
    think -> done [label = "Confidence High"];
    done -> [*];
}
