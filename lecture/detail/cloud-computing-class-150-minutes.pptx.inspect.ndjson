{"kind":"textbox","id":"sh/gjid4zup","slide":3,"text":"A useful definition","textPreview":"A useful definition","textChars":19,"textLines":1,"bbox":[72,150,420,36]}
{"kind":"textbox","id":"sh/hkrux4va","slide":3,"text":"On-demand access to a shared pool of configurable computing resources that can be rapidly provisioned and released.","textPreview":"On-demand access to a shared pool of configurable computing resources that can be rapidly provisioned and released.","textChars":115,"textLines":1,"bbox":[72,204,980,92]}
